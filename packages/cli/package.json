{
  "name": "api-seeder",
  "version": "1.0.0",
  "description": "Industrial hierarchical Excel/CSV data ingestion engine & seed orchestrator for REST APIs",
  "author": "Albert Kameni <albertk.explorer@gmail.com> (https://github.com/albertk-dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertk-dev/api-seeder.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/albertk-dev/api-seeder#readme",
  "bugs": {
    "url": "https://github.com/albertk-dev/api-seeder/issues"
  },
  "keywords": [
    "api-seeder",
    "cli",
    "excel",
    "csv",
    "seeder",
    "rest-api",
    "etl",
    "studio",
    "database-seeder",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "api-seeder": "./bin/api-seeder.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin/api-seeder.js",
    "bin/api-seeder.mjs",
    "ui"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && tsup bin/api-seeder.ts --format esm --out-dir bin --no-dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@api-seeder/core": "workspace:*",
    "@clack/prompts": "^0.10.1",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
