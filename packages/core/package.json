{
  "name": "@api-seeder/core",
  "version": "1.0.0",
  "description": "Core data ingestion engine, dependency resolver, and seed orchestrator for API Seeder",
  "author": "Albert Kameni <albertk.explorer@gmail.com> (https://github.com/albertk-dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertk-dev/api-seeder.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/albertk-dev/api-seeder#readme",
  "bugs": {
    "url": "https://github.com/albertk-dev/api-seeder/issues"
  },
  "keywords": [
    "seeder",
    "api-seeder",
    "core",
    "excel",
    "csv",
    "rest-api",
    "ingestion",
    "dag",
    "data-seeding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.5.3",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/papaparse": "^5.3.15",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
