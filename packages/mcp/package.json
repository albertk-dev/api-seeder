{
  "name": "@api-seeder/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for API Seeder - AI Agent Data Ingestion & Schema Mapping",
  "author": "Albert Kameni <albertk.explorer@gmail.com> (https://github.com/albertk-dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertk-dev/api-seeder.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/albertk-dev/api-seeder#readme",
  "bugs": {
    "url": "https://github.com/albertk-dev/api-seeder/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api-seeder",
    "ai",
    "claude",
    "cursor",
    "antigravity",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "api-seeder-mcp": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "dependencies": {
    "@api-seeder/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
